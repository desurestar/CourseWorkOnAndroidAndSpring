<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_profile_posts_tab"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/adminUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/recipe_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/adminUserEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_caption"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <CheckBox
            android:id="@+id/adminUserIsAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_role_admin" />

        <Button
            android:id="@+id/buttonDeleteUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/admin_delete" />
    </LinearLayout>
</LinearLayout>
