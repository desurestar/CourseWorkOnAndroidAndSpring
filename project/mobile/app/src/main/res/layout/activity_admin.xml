<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/recipe_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/adminToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="2dp"
        android:padding="4dp"
        app:title="@string/admin_panel_title"
        app:titleTextColor="@color/recipe_primary">

        <ImageButton
            android:id="@+id/buttonAdminBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/admin_back"
            android:src="@android:drawable/ic_media_previous" />
    </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/adminTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/recipe_primary"
        app:tabSelectedTextColor="@color/recipe_primary"
        app:tabTextColor="@color/text_muted">

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_admin_posts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_tab_posts" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_admin_ingredients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_tab_ingredients" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_admin_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_tab_tags" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_admin_users"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_tab_users" />
    </com.google.android.material.tabs.TabLayout>

    <ProgressBar
        android:id="@+id/adminProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/adminError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_dark"
        android:visibility="gone"
        android:padding="4dp" />

    <ViewFlipper
        android:id="@+id/adminContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/inputPostSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/admin_search_posts" />

                    <Button
                        android:id="@+id/buttonRefreshPosts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_refresh" />
                </LinearLayout>

                <TextView
                    android:id="@+id/postsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_empty"
                    android:textColor="@color/text_caption"
                    android:visibility="gone"
                    android:padding="8dp" />

                <LinearLayout
                    android:id="@+id/postsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:dividerPadding="8dp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/inputIngredientName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/admin_new_ingredient" />

                    <Button
                        android:id="@+id/buttonAddIngredient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_add" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ingredientsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_empty"
                    android:textColor="@color/text_caption"
                    android:visibility="gone"
                    android:padding="8dp" />

                <LinearLayout
                    android:id="@+id/ingredientsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/inputTagName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/admin_new_tag" />

                    <EditText
                        android:id="@+id/inputTagColor"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/admin_tag_color"
                        android:text="#FF5733" />

                    <Button
                        android:id="@+id/buttonAddTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_add" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tagsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_empty"
                    android:textColor="@color/text_caption"
                    android:visibility="gone"
                    android:padding="8dp" />

                <LinearLayout
                    android:id="@+id/tagsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/inputUserSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/admin_search_users" />

                    <Button
                        android:id="@+id/buttonRefreshUsers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_refresh" />
                </LinearLayout>

                <TextView
                    android:id="@+id/usersEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_empty"
                    android:textColor="@color/text_caption"
                    android:visibility="gone"
                    android:padding="8dp" />

                <LinearLayout
                    android:id="@+id/usersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>
</LinearLayout>
