<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_profile_posts_tab"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/adminPostTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/recipe_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/adminPostMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_caption"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Spinner
            android:id="@+id/adminPostStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonOpenPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_open" />

        <Button
            android:id="@+id/buttonDeletePost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_delete" />
    </LinearLayout>
</LinearLayout>
